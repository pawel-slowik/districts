{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.5/resources/schema.json",
    "source": {
        "directories": [
            "../../bin",
            "../../public",
            "../../src"
        ]
    },
    "phpUnit": {
        "configDir": "../.."
    },
    "threads": "max",
    "minMsi": 75,
    "minCoveredMsi": 80,
    "mutators": {
        "@default": true
    }
}
